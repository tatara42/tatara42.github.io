---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      h1 {
        text-align: center;
      }
    </style>
	</head>
	<body>
		<Header />
		<main>
      <h1>🐈Greetings, </h1>
      <h1>Curious Cat!</h1>
      <p>The website contains my knowledge that I have gained through the years</p>
      <h3>The topics are:</h3>
      <ul>
        <li>Embedded programming</li>
        <li>3D Modelling</li>
        <li>Game Modding</li>
        <li>Video Games</li>
      </ul>
      <p>This is a documentation of things that I wish I knew back then.</p>
      <p>You can check about me <a href="/about">here</a>.</p>
		</main>
		<Footer />
	</body>
</html>
